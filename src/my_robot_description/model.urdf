<robot name="my_mobile">
  <gazebo>
    <plugin filename="libgazebo_ros_diff_drive.so" name="diff_drive_controller">
      <ros>
        <namespace>/</namespace>
      </ros>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.6</wheel_separation>
      <wheel_radius>0.1</wheel_radius>
      <wheel_diameter>0.2</wheel_diameter>
      <publish_odom>true</publish_odom>
      <odom_topic>odom</odom_topic>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>
  <link name="base_link">
    <visual>
      <origin rpy="0 -0.785 0" xyz="0 0 0.0"/>
      <geometry>
        <!-- <mesh filename="package://my_robot_description/meshes/visual/base_link.dae" scale="1 1 1"/> -->
        <mesh filename="package://my_robot_description/meshes/visual/sejongDel_body.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 -0.785 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/collision/sejongDel_body.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
      <origin xyz="0 0 0.0"/>
    </inertial>
  </link>
  <link name="left_wheel">
    <visual>
      <origin rpy="0 0 ${pi/2}" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/visual/wheel.dae" scale="5 5 5"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 ${pi/2}" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/collision/wheel.stl" scale="5 5 5"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
      <origin xyz="0 0 0"/>
    </inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin rpy="0 0 0" xyz="${0.3-wheel_radius} ${wheel_separation/2+0.05} 0.25"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="right_wheel">
    <visual>
      <origin rpy="0 0 -${pi/2}" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/visual/wheel.dae" scale="5 5 5"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 -${pi/2}" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/collision/wheel.stl" scale="5 5 5"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
      <origin xyz="0 0 0"/>
    </inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin rpy="0 0 0" xyz="${0.3-wheel_radius} -${wheel_separation/2+0.05} 0.25"/>
    <axis xyz="0 1 0"/>
  </joint>
    <link name="rear_wheel">
    <visual>
      <origin rpy="0 0 ${pi/2}" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/visual/wheel.dae" scale="2 2 2"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 ${pi/2}" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/collision/wheel.stl" scale="2 2 2"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
      <origin xyz="0 0 0"/>
    </inertial>
  </link>
  <joint name="rear_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_wheel"/>
    <origin rpy="0 0 0" xyz="-${0.1+wheel_radius-0.15} 0 -0.15"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="front_camera">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/visual/front_camera.dae" scale="0.001 0.001 0.001"/>
